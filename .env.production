# Env untuk build produksi frontend (`vite build`, dipakai oleh build:web).
# Vite memuat .env lalu menimpanya dengan .env.production saat mode=production.
#
# API base KOSONG = same-origin (URL relatif). Wajib untuk 1 link ngrok: browser
# akan memanggil /api/v1/... pada origin yang sama (host ngrok) alih-alih
# http://localhost:3000 yang tidak bisa dijangkau dari perangkat/tunnel lain.
VITE_API_BASE_URL=
