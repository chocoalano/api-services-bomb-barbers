{
  "name": "api-services",
  "version": "1.0.50",
  "scripts": {
    "start": "NODE_ENV=production PROCESS_ROLE=api bun run src/server.ts",
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun run --watch src/server.ts",
    "start:web": "NODE_ENV=production PROCESS_ROLE=web bun run src/web/server.ts",
    "dev:web": "WEB_ASSET_MODE=dev bun run --watch src/web/server.ts",
    "dev:web-assets": "vite --host 0.0.0.0",
    "build:web": "vite build",
    "serve:fullstack": "bun run src/server-fullstack.ts",
    "tunnel": "bun run build:web && bun run src/server-fullstack.ts",
    "worker": "NODE_ENV=production PROCESS_ROLE=worker bun run src/worker.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "db:reset": "bun run src/db/reset.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed:starter": "bun run src/db/seed.ts --starter"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/stream": "^1.1.0",
    "@elysiajs/swagger": "^1.3.1",
    "@iconify-json/lucide": "^1.2.116",
    "@iconify/vue": "^5.0.1",
    "@inertiajs/vite": "^3",
    "@inertiajs/vue3": "^3",
    "@nuxt/ui": "^4",
    "@sinclair/typebox": "^0.34.49",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "argon2": "^0.44.0",
    "bullmq": "^5.78.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "latest",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "mysql2": "^3.22.6",
    "pino": "^10.3.1",
    "rotating-file-stream": "^3.2.9",
    "sharp": "^0.35.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.4",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.7"
  },
  "module": "src/index.js"
}
