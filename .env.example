APP_PORT=3000
SOCKET_PORT=3001
APP_ENV=development
NODE_ENV=development

# Base URL server API yang di-compile ke bundle frontend backoffice (Vite).
# Halaman backoffice disajikan web server (WEB_PORT, default 5174) sedangkan API
# berjalan di APP_PORT (3000), jadi base URL harus absolut.
VITE_API_BASE_URL=http://localhost:3000

# Sertakan origin web backoffice (5174) agar login backoffice tidak diblokir CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
SOCKET_WEBSOCKET_ONLY=false

# Database MySQL 8.x (migrasi dari PostgreSQL/Supabase → Drizzle ORM + mysql2).
# Dua cara konfigurasi (pilih salah satu):
#  1. DATABASE_URL utuh — format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:root@localhost:3306/bomb_barbers
#  2. Bagian terpisah (dipakai bila DATABASE_URL/MYSQL_URL kosong):
# DATABASE_SERVER=localhost
# DATABASE_PORT=3306
# DATABASE_USER=root
# DATABASE_PASSWORD=
# DATABASE_NAME=bun_bomb_barber

# WAJIB kuat di produksi (min 32 karakter, bukan nilai default).
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_TTL_SECONDS=604800

# Set 'true' HANYA jika berada di belakang reverse proxy tepercaya yang menuliskan
# ulang X-Forwarded-For. Jika tidak, biarkan 'false' agar rate-limit tak bisa di-bypass.
TRUST_PROXY=false

# Proteksi autentikasi
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REFRESH_RATE_LIMIT_MAX=20
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60

REDIS_URL=redis://localhost:6379

# Media storage — DISK LOKAL (storage lokal).
# File publik ditulis ke public/media/ (disajikan di ${MEDIA_BASE_URL}/public/media/...).
# File privat ditulis ke MEDIA_PRIVATE_DIR & diakses via signed URL (HMAC + expiry).
# MEDIA_BASE_URL harus URL absolut yang bisa dijangkau aplikasi mobile.
MEDIA_BASE_URL=http://localhost:3000
MEDIA_PRIVATE_DIR=storage/private
# Kunci HMAC signed URL media privat (default: JWT_ACCESS_SECRET bila kosong).
MEDIA_SIGN_SECRET=
MEDIA_SIGNED_URL_TTL_SECONDS=3600
MEDIA_MAX_WIDTH=6000
MEDIA_MAX_HEIGHT=6000
MEDIA_MAX_PIXELS=25000000

# Tracking realtime
TRACKING_LOCATION_TTL_SECONDS=120
TRACKING_SESSION_TTL_SECONDS=14400
TRACKING_MAX_LOCATION_AGE_MS=120000
TRACKING_MAX_FUTURE_SKEW_MS=30000
TRACKING_RATE_LIMIT_MAX=10
TRACKING_RATE_LIMIT_WINDOW_SECONDS=2
TRACKING_FALLBACK_SPEED_KMH=25
ROUTING_API_URL=
ROUTING_API_TOKEN=

# Jalankan worker BullMQ di dalam proses API (all-in-one) — praktis untuk dev.
# Produksi: set 'false' dan jalankan `bun run worker` sebagai proses terpisah.
# JANGAN set 'true' sekaligus menjalankan worker terpisah (job akan diproses ganda).
RUN_WORKERS_IN_PROCESS=true

# Integritas booking dan timeout appointment
ORDER_ACCEPTANCE_TIMEOUT_MINUTES=60
APPOINTMENT_NO_SHOW_GRACE_MINUTES=15
HOME_SERVICE_TRAVEL_BUFFER_MINUTES=15

# Payment Gateway — Midtrans
# Sandbox: prefix SB-Mid-server-. Produksi: prefix Mid-server- + MIDTRANS_IS_PRODUCTION=true.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# Payment Gateway — Xendit (opsional; wajib jika provider 'xendit' dipakai)
XENDIT_CALLBACK_TOKEN=
